    "\u2502   \u2502  JSON   \u2502  Blockchain-Daten von bitcoin-etl                             \u2502\n",
    "\u2502   \u2514\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2518                                                               \u2502\n",
    "\u2502        \u2502                                                                    \u2502\n",
