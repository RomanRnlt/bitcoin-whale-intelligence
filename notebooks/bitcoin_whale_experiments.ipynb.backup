    "\u2502      \u2514\u2500\u2500 transactions/         \u2502                                    \u2502\n",
    "\u2502          \u2514\u2500\u2500 *.json         \u2500\u2500\u2500\u253c\u2500\u2500\u25b6  Spark DataFrame                \u2502\n",
    "\u2502                                \u2502     (verteilt auf alle Kerne)      \u2502\n",
