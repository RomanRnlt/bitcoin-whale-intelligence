   "cell_type": "code",
   "execution_count": 21,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Balance Events erstellt\n",
      "==================================================\n",
      "Total Events:    336,423\n",
      "CREATED (+BTC):  197,533\n",
      "SPENT (-BTC):    138,890\n",
      "CPU times: user 3.3 ms, sys: 1.88 ms, total: 5.18 ms\n",
