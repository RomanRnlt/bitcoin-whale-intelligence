    "if len(recent_data) > 0:\n",
    "    # Chart 1: Kumulative Netto-Veränderung (zeigt Trend besser)\n",
    "    recent_data[\"cumulative_net\"] = recent_data[\"net_change_btc\"].cumsum()\n",
    "\n",
    "    ax1 = axes[0]\n",
    "    ax1.fill_between(\n",
    "        range(len(recent_data)),\n",
    "        recent_data[\"cumulative_net\"],\n",
