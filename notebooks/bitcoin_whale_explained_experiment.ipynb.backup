    "        where=recent_data[\"cumulative_net\"] < 0,\n",
    "        alpha=0.3,\n",
    "        color=\"red\",\n",
    "        label=\"Distribution\",\n",
    "    )\n",
    "    ax1.plot(range(len(recent_data)), recent_data[\"cumulative_net\"], color=\"black\", linewidth=2)\n",
